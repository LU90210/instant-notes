{
  "name": "instant-notes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "阅读现场的 AI 笔记助手。Manifest V3 浏览器扩展。",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
